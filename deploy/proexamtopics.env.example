# ProExamTopics (site 2) production .env - TEMPLATE. Copy to the server as .env and fill in the
# values marked CHANGE_ME ON THE SERVER. Never commit a real .env.

APP_NAME=ProExamTopics
APP_ENV=production
APP_KEY=                      # php artisan key:generate (do NOT copy another site's key)
APP_DEBUG=false
APP_URL=https://proexamtopics.com

# --- Which site this server is -------------------------------------------------
APP_SITE_ID=2
APP_SITE_MODE=standalone
SITE_VIEW_OVERRIDE=proexamtopics
EXAM_URL_STYLE=root
SITE_CATALOG_MODE=all

# --- Shared database (Site 1's MySQL, reached through Hostinger "Remote MySQL") ---
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_ON_THE_SERVER
DB_PORT=3306
DB_DATABASE=CHANGE_ME_ON_THE_SERVER
DB_USERNAME=CHANGE_ME_ON_THE_SERVER
DB_PASSWORD=CHANGE_ME_ON_THE_SERVER

# --- Keep this site's sessions / cache / queue apart from Site 1 ----------------
SESSION_DRIVER=database
SESSION_COOKIE=proexamtopics_session
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=proexamtopics_cache_
QUEUE_CONNECTION=database
DB_QUEUE=proexamtopics

LOG_CHANNEL=stack
LOG_LEVEL=warning
FILESYSTEM_DISK=local

# --- Mail (use a mailbox on proexamtopics.com; CHANGE_ME on the server) -----------
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_ON_THE_SERVER
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_ON_THE_SERVER
MAIL_PASSWORD=CHANGE_ME_ON_THE_SERVER
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=support@proexamtopics.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Payments: this site's OWN Stripe keys and webhook secret ------------------------
STRIPE_KEY=CHANGE_ME_ON_THE_SERVER
STRIPE_SECRET=CHANGE_ME_ON_THE_SERVER
STRIPE_WEBHOOK_SECRET=CHANGE_ME_ON_THE_SERVER

# --- Shared PDF storage: the SAME Cloudflare R2 bucket as Site 1 ---------------------
AWS_ACCESS_KEY_ID=CHANGE_ME_ON_THE_SERVER
AWS_SECRET_ACCESS_KEY=CHANGE_ME_ON_THE_SERVER
AWS_BUCKET=CHANGE_ME_ON_THE_SERVER
AWS_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_DEFAULT_REGION=auto
