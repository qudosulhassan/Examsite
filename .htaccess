<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical hostname: force non-www. Runs first so it applies to every request.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # /index.php as a real external redirect (not the Laravel route -- when Apache serves
    # this file because it physically exists, it bypasses the internal "send to public/"
    # rewrite entirely, and the resulting SCRIPT_NAME/PATH_INFO confusion was leaking
    # /public/index.php into the page's own canonical tag). Must fire before the
    # "send to public directory" rule below.
    RewriteRule ^index\.php$ / [L,R=301]

    # Block access to sensitive files (.env, .git, composer.json, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F]
    RewriteRule ^composer\.(json|lock) - [F]
    RewriteRule ^package(-lock)?\.json - [F]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Public Directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
